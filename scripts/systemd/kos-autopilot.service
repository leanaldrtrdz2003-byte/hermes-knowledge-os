[Unit]
Description=KOS autopilot: ingesta incremental + worker + wiki/grafo/dashboard + backup
After=network-online.target docker.service ollama.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/hermes-knowledge-os
ExecStart=%h/hermes-knowledge-os/scripts/autopilot.sh
# El autopilot es idempotente: dedupe por hash SHA-256 → solo indexa novedades.
StandardOutput=append:/tmp/kos-cron.log
StandardError=append:/tmp/kos-cron.log
TimeoutStartSec=5400