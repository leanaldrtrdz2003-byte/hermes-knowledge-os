# ============================================================
# Hermes Knowledge OS — .env.example
# 1) cp .env.example .env
# 2) Rellena los CHANGE_ME y las claves LLM.
# 3) NUNCA subas .env a git (está en .gitignore).
# ============================================================

# --- Rutas ---
PROJECT_ROOT=${PROJECT_ROOT:-$(pwd)}
OBSIDIAN_VAULT_PATH=${OBSIDIAN_VAULT_PATH:-$PROJECT_ROOT/vault}
MINIO_SOURCE_BUCKET=sources

# --- PostgreSQL (control plane / metadatos) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=kos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=knowledge_os

# --- Qdrant (vectores) ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# --- MinIO / S3 (fuentes inmutables) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1
S3_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- LLM generativo (todo el pipeline: graph, wiki, router, LightRAG) ---
# Proveedor: ollama (local) | openai (cualquier endpoint OpenAI-compatible).
# Recomendado: modelo remoto barato vía endpoint compatible.
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-flash-free
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT=1200

# --- Fallback del LLM (cadena: primario -> fallback; misma idea que Hermes) ---
# Si el LLM primario falla (error/rate-limit), el pipeline usa este 2º modelo.
LLM_FALLBACK_BASE_URL=https://opencode.ai/zen/go/v1
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_FALLBACK_API_KEY=CHANGE_ME

# --- Embeddings (SIEMPRE locales por defecto; no comparten URL con el LLM) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_DIMENSION=1024
# alternativas: nomic-embed-text (768), all-minilm (384)
# Si EMBEDDING_PROVIDER=api:
EMBEDDING_API_KEY=
EMBEDDING_API_URL=

# --- Prompts / seguridad ---
PROMPT_INJECTION_FENCE=true   # delimita contenido externo (§33)
MAX_SOURCE_MB=200             # límites de tamaño de fuente (§32)

# --- Versionado de pipeline (§16) ---
PIPELINE_VERSION=0.1.0
EMBEDDING_VERSION=v1